# Copy to .env.local for `pnpm dev`. Everything is optional locally.

# ---------- Database ----------
# d1 (default): Cloudflare D1. `pnpm dev` uses a local D1 under .wrangler/.
# postgres: any Postgres — a HYPERDRIVE binding on Workers, DATABASE_URL on Node.
DATABASE_PROVIDER=
DATABASE_URL=

# ---------- Auth ----------
# Required in production (the Cloudflare deploy generates it). openssl rand -hex 32
BETTER_AUTH_SECRET=
# Canonical URL. Optional: inferred from the request when unset.
BETTER_AUTH_URL=
# invite (default): after the first account, sign-up needs an invite link.
# open: anyone can create an account (hosted mode).
SIGNUP_MODE=
# Google sign-in (optional). Redirect URI: <app url>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Email (optional) ----------
# Without Resend, invites are shared as links and there are no verification emails.
RESEND_API_KEY=
EMAIL_FROM=

# ---------- Transcription (optional) ----------
# Groq Whisper (fast, recommended). Without it, Cloudflare deploys use Workers AI.
GROQ_API_KEY=

# ---------- Media storage on Node (not needed on Cloudflare) ----------
# Any S3-compatible bucket (R2, S3, MinIO). Keep the bucket private.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

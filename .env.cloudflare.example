# Settings for `pnpm deploy:cloudflare`. Copy to .env.cloudflare (git-ignored).

# ---------- Which Cloudflare account (recommended if you have several) ----------
# An account-owned API token keeps this deploy isolated to one account:
# Dashboard → (your account) → Manage Account → Account API Tokens → Create → Custom token with
#   Workers Scripts: Edit · D1: Edit · Workers R2 Storage: Edit · Account Settings: Read
#   (optional: Workers Tail: Read for `wrangler tail`)
# Without these, the script uses your `wrangler login` session.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# ---------- Optional features (uploaded as encrypted Worker secrets) ----------

# Faster, more reliable transcripts (https://console.groq.com). Without it, Workers AI is used.
# GROQ_API_KEY=

# Email invites + password resets (https://resend.com). Without it, invites are links you send.
# RESEND_API_KEY=
# EMAIL_FROM=Lore <lore@yourdomain.com>

# "Continue with Google". Redirect URI: <your url>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional custom domain in an active Cloudflare zone in this account.
# The deploy script attaches this hostname automatically (HTTPS origin only).
# API tokens also need Workers Routes: Edit for the zone.
# BETTER_AUTH_URL=https://memories.example.com

# invite (default): after the first account, sign-up needs an invite link.
# open: anyone can sign up.
# SIGNUP_MODE=invite

# Resource names (defaults: lore, lore, lore-media, lore-backups).
# LORE_WORKER_NAME=lore
# LORE_D1_NAME=lore
# LORE_R2_BUCKET=lore-media
# LORE_BACKUPS_BUCKET=lore-backups

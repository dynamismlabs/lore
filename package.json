{
  "name": "lore",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "postinstall": "pnpm cf-typegen",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "tsx scripts/deploy-cloudflare.ts",
    "deploy:landing": "tsx scripts/deploy-landing.ts",
    "mcp-views:build": "tsx scripts/build-mcp-views.ts",
    "ts": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "prettier": "prettier --write \"./src/**/*.{js,json,ts,tsx,md}\"",
    "db:generate": "drizzle-kit generate --config drizzle.sqlite.config.ts && drizzle-kit generate --config drizzle.pg.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:pg": "drizzle-kit migrate --config drizzle.pg.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.sqlite.config.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --env-file .env.example --strict-vars=false cloudflare-env.d.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opennextjs/cloudflare": "^1.20.15",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.100.9",
    "@tiptap/core": "^3.7.2",
    "@tiptap/extension-typography": "^3.7.2",
    "@tiptap/extensions": "^3.7.2",
    "@tiptap/markdown": "^3.7.2",
    "@tiptap/pm": "^3.7.2",
    "@tiptap/react": "^3.7.2",
    "@tiptap/starter-kit": "^3.7.2",
    "@trpc/client": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "exifreader": "^4.32.0",
    "lucide-react": "^0.471.1",
    "next": "^16.4.3",
    "next-themes": "^0.4.5",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/typography": "^0.5.16",
    "@trivago/prettier-plugin-sort-imports": "^5.2.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.4.3",
    "miniflare": "5.20261023.3-beta",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.10",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.156.0"
  }
}
